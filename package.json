{
  "name": "rh-system",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo RH-System — API (backend) + frontend",
  "license": "MIT",
  "author": "Felipe Molz, João Gabriel W",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:test": "node scripts/iniciar-ambiente-teste.mjs",
    "dev:test:backend": "npm run dev:test -w backend",
    "dev:test:frontend": "npm run dev:test -w frontend",
    "start": "npm run start -w backend",
    "test": "npm test -w backend",
    "test:frontend": "npm test -w frontend",
    "test:all": "npm test -w backend && npm test -w frontend",
    "test:e2e": "playwright test -c playwright.config.mjs",
    "test:e2e:ui": "playwright test -c playwright.config.mjs --ui",
    "test:deploy": "npm run test:all && npm run test:e2e",
    "test:integracao": "npm run test:integracao -w backend",
    "test:routes": "npm run test:routes -w backend",
    "test:coverage": "npm run test:coverage -w backend && npm run test:coverage -w frontend",
    "test:coverage:backend": "npm run test:coverage -w backend",
    "test:coverage:frontend": "npm run test:coverage -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "lint:backend": "npm run lint -w backend",
    "lint:frontend": "npm run lint -w frontend",
    "deploy:prod": "npm run deploy:prod -w backend",
    "docker:prod:up": "npm run docker:prod:up -w backend",
    "docker:prod:down": "npm run docker:prod:down -w backend",
    "db:prod:migrate": "npm run db:prod:migrate -w backend",
    "seed:admin:prod": "npm run seed:admin:prod -w backend",
    "backup:prod": "npm run backup:prod -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
