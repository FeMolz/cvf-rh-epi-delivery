# Copie para .env.production.local e substitua [YOUR-PASSWORD] pela senha do banco Supabase.
# Nunca commite .env.production.local (já está no .gitignore).

PORT=3000
NODE_ENV=production
DB_HOST=0.0.0.0

# Runtime da API — pooler transacional Supavisor (porta 6543)
DATABASE_URL="postgresql://postgres.himwyhvmalwtlrlyzzia:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (db push / migrate) — pooler sessão (porta 5432)
DIRECT_URL="postgresql://postgres.himwyhvmalwtlrlyzzia:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Mínimo 32 caracteres em produção
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# Obrigatório em produção — domínios do frontend
CORS_ORIGINS="https://app.suaempresa.com"

# Obrigatório em produção
REDIS_URL="redis://127.0.0.1:6379"

TRUST_PROXY_SALTOS=1
HEALTH_CHECK_TOKEN=""

# Seed inicial (somente no primeiro deploy)
ADMIN_SEED_EMAIL="admin@suaempresa.com"
ADMIN_SEED_PASSWORD=""

CAEPI_API_URL="http://localhost:8080"
# Em produção o servidor aguarda a API antes de aceitar requisições (padrão: true)
# CAEPI_AGUARDAR_INICIO=true
# SECULLUM_USUARIO=""
# SECULLUM_SENHA=""
# SECULLUM_BANCO_ID=""
