# Copie para .env.production.local e substitua [YOUR-PASSWORD] pela senha do banco Supabase.
# Nunca commite .env.production.local (já está no .gitignore).

PORT=3000
NODE_ENV=production
DB_HOST=0.0.0.0

# Runtime da API — pooler transacional Supavisor (porta 6543)
DATABASE_URL="postgresql://postgres.himwyhvmalwtlrlyzzia:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (migrate deploy / backup) — pooler sessão (porta 5432)
DIRECT_URL="postgresql://postgres.himwyhvmalwtlrlyzzia:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Mínimo 32 caracteres em produção
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# Obrigatório em produção — placeholder até o frontend existir (Postman/curl não usam CORS)
CORS_ORIGINS="https://app.suaempresa.com"

# Obrigatório em produção — Redis Cloud (ex.: rediss://default:senha@host:porta)
REDIS_URL=""

TRUST_PROXY_SALTOS=1
HEALTH_CHECK_TOKEN=""

# Seed inicial (somente no primeiro deploy)
ADMIN_SEED_EMAIL="admin@suaempresa.com"
ADMIN_SEED_PASSWORD=""

# Docker compose produção: http://caepi-api (rede interna)
# CAEPI em host separado: URL pública acessível pela API
CAEPI_API_URL="http://caepi-api"
# Piloto sem API CAEPI no ar: true + execute npm run seed:epis:cache:prod
# CAEPI_USAR_SOMENTE_CACHE=true
# O seed popula ~17 EPIs reais no cache; vínculos com cargos são feitos na interface.
# Em produção o servidor aguarda a API antes de aceitar requisições (padrão: true)
# CAEPI_AGUARDAR_INICIO=true
# SECULLUM_USUARIO=""
# SECULLUM_SENHA=""
# SECULLUM_BANCO_ID=""

# E-mail de convite de cadastro (obrigatório em produção) — senha de app do Gmail
GMAIL_USER=""
GMAIL_PASS=""
# URL pública do frontend (sem barra final)
FRONTEND_PUBLIC_URL="https://app.suaempresa.com"

# Supabase Storage — PDFs de relatórios de EPI (obrigatório em produção)
# Project Settings → API: copie URL e service_role (nunca exponha no frontend)
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket privado criado no painel (Storage → New bucket → nome: epi-reports)
SUPABASE_STORAGE_BUCKET_EPI_REPORTS="epi-reports"
