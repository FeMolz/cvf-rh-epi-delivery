# Copie para .env.test e ajuste credenciais.
# Use APENAS para API manual (Postman) e seeds — nunca aponte para produção.

PORT=3001
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rh_system_test?schema=public"
DB_HOST=localhost

# Mínimo 16 caracteres em desenvolvimento/teste; 32 em produção
JWT_SECRET="jwt-secreto-apenas-ambiente-teste-com-16-chars"
JWT_EXPIRES_IN="7d"

# CORS: em produção liste origens explícitas (obrigatório)
# CORS_ORIGINS="https://app.empresa.com,https://admin.empresa.com"

# Redis (obrigatório em produção; opcional em dev — fallback em memória)
REDIS_URL="redis://localhost:6379"

# Health check em produção (header X-Health-Token)
# HEALTH_CHECK_TOKEN="token-monitoramento-interno"

# Rate limits (opcional)
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_PUBLICO_MAX=60
# RATE_LIMIT_GLOBAL_MAX=300

# Link público de cadastro de contratação (dias)
# TOKEN_CADASTRO_VALIDADE_DIAS=7

# E-mail de convite (Nodemailer / Gmail) — use senha de app; nunca commite valores reais
# GMAIL_USER=""
# GMAIL_PASS=""
# URL pública do frontend (link absoluto no e-mail)
# FRONTEND_PUBLIC_URL="http://localhost:5173"

# Atrás de proxy reverso (ex.: 1 hop no nginx)
# TRUST_PROXY_SALTOS=1

# Seed do administrador (recomendado em dev)
# ADMIN_SEED_EMAIL="admin@rhsystem.com"
# ADMIN_SEED_PASSWORD="AlterarSenha123!"
# ADMIN_SEED_NAME="Administrador do Sistema"

# Integrações (opcional)
CAEPI_API_URL="http://localhost:8080"

# PDF de relatórios EPI (Puppeteer) — após npm run puppeteer:install -w backend
# Windows (Chrome instalado): descomente se o Puppeteer não achar o navegador
# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# Supabase Storage — relatórios EPI (dev/teste usam bucket separado de produção)
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET_EPI_REPORTS="epi-reports-dev-teste"
# SECULLUM_USUARIO=""
# SECULLUM_SENHA=""
# SECULLUM_BANCO_ID=""
