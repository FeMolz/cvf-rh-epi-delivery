{
  "name": "backend",
  "version": "1.0.0",
  "description": "API RH-System (Express + Prisma + PostgreSQL)",
  "license": "MIT",
  "author": "Felipe Molz, João Gabriel W",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "npm run prisma:generate && nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node prisma/seeders/admin.js",
    "seed:admin:test": "node prisma/scripts/executar-com-ambiente-teste.mjs prisma/seeders/admin.js",
    "seed:test-data": "node prisma/seeders/seed_sistema_completo.js",
    "seed:epis": "node prisma/seeders/seed_epis.js",
    "seed:epis:cache": "node prisma/seeders/seed_epis_cache_producao.js",
    "seed:epis:cache:test": "node prisma/scripts/executar-com-ambiente-teste.mjs prisma/seeders/seed_epis_cache_producao.js",
    "seed:epis:cache:prod": "node prisma/scripts/executar-com-ambiente-producao.mjs node prisma/seeders/seed_epis_cache_producao.js",
    "epis:cache:gerar": "node scripts/gerar-epis-comuns-cache.mjs",
    "seed:dev-token": "node prisma/seeders/generate-dev-token.js",
    "seed:all": "node prisma/seeders/seed_sistema_completo.js",
    "seed:all:test": "node prisma/scripts/executar-com-ambiente-teste.mjs prisma/seeders/seed_sistema_completo.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathIgnorePatterns integracao.test",
    "test:integracao": "node prisma/scripts/executar-testes-integracao.mjs",
    "test:routes": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPatterns routes.test --testPathPatterns app.health.test",
    "dev:test": "npm run prisma:generate && node prisma/scripts/executar-com-ambiente-teste.mjs ../node_modules/nodemon/bin/nodemon.js src/server.js",
    "db:test:migrate": "node prisma/scripts/preparar-banco-teste.mjs --apenas-schema",
    "db:test:push": "node prisma/scripts/preparar-banco-teste.mjs --apenas-schema",
    "db:test:seed": "node prisma/scripts/preparar-banco-teste.mjs",
    "db:test:reset": "docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.test.yml up -d && node prisma/scripts/preparar-banco-teste.mjs",
    "db:test:reset:minimo": "docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.test.yml up -d && node prisma/scripts/preparar-banco-teste.mjs --apenas-schema && npm run seed:admin:test && npm run seed:epis:cache:test",
    "db:prod:push": "node prisma/scripts/executar-com-ambiente-producao.mjs npx prisma db push",
    "db:prod:migrate": "node prisma/scripts/executar-com-ambiente-producao.mjs npx prisma migrate deploy",
    "backup:prod": "node prisma/scripts/executar-com-ambiente-producao.mjs node scripts/backup-postgres-se-mudou.mjs",
    "dev:prod": "node prisma/scripts/executar-com-ambiente-producao.mjs node src/server.js",
    "seed:admin:prod": "node prisma/scripts/executar-com-ambiente-producao.mjs node prisma/seeders/admin.js",
    "docker:apoio:up": "node scripts/iniciar-apoio-docker.mjs",
    "docker:apoio:down": "docker compose -f docker-compose.apoio.yml down",
    "docker:prod:up": "docker compose -f docker-compose.producao.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.producao.yml down",
    "deploy:prod": "node scripts/deploy-producao.mjs",
    "start:com-apoio": "node scripts/iniciar-servidor-com-apoio.mjs",
    "start:prod:com-apoio": "node scripts/iniciar-producao-com-apoio.mjs",
    "dev:com-apoio": "node scripts/iniciar-apoio-docker.mjs && nodemon src/server.js",
    "lint": "eslint src",
    "puppeteer:install": "puppeteer browsers install chrome"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.108.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "puppeteer": "^24.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.4.1",
    "nodemon": "^3.1.14",
    "prettier": "3.8.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2"
  }
}
