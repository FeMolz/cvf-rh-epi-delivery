generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    ADMIN
    ADMINISTRATIVO
    ALMOXARIFADO
    COLABORADOR
}

enum EmployeeStatus {
    ATIVO
    INATIVO
    DESLIGADO
    RESCINDIDO
    APOSENTADO
    FERIAS
    LICENCA_MATERNIDADE
    LICENCA_MED
}

enum EstadoCivil {
    SOLTEIRO
    CASADO
    DIVORCIADO
    SEPARADO
    VIUVO
    UNIAO_ESTAVEL
}

enum RacaCor {
    BRANCA
    PRETA
    PARDA
    AMARELA
    INDIGENA
    NAO_DECLARADO
}

enum GrauInstrucao {
    ANALFABETO
    FUNDAMENTAL_INCOMPLETO
    FUNDAMENTAL_COMPLETO
    MEDIO_INCOMPLETO
    MEDIO_COMPLETO
    SUPERIOR_INCOMPLETO
    SUPERIOR_COMPLETO
    POS_GRADUACAO
    MESTRADO
    DOUTORADO
}

enum StatusAnuncioVaga {
    ATIVA
    INATIVA
    ENCERRADA
}

enum TipoContratacaoVaga {
    CLT
    PJ
    ESTAGIO
    TEMPORARIO
    APRENDIZ
    OUTRO
}

enum StatusCadastroContratacao {
    AGUARDANDO_PREENCHIMENTO
    AGUARDANDO_ANALISE_RH
    CONTRATADO
    DESCONTINUADO
}

model Company {
    id       String  @id @default(uuid())
    name     String
    cnpj     String  @unique
    isActive Boolean @default(true)

    employee     Employee[]
    anunciosVaga AnuncioVaga[]
    cadastrosContratacao CadastroContratacao[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Setor {
    id       String  @id @default(uuid())
    nome     String  @unique
    isActive Boolean @default(true)

    employees Employee[]
    anunciosVaga           AnuncioVaga[]
    cadastrosContratacao CadastroContratacao[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model User {
    id           String    @id @default(uuid())
    name         String
    email        String    @unique
    passwordHash String
    role         UserRole
    isActive     Boolean   @default(false)
    lastLogin    DateTime?

    epiDeliveries EpiDelivery[]

    epiDeliveryReportsGenerated EpiDeliveryReport[] @relation("EpiDeliveryReportGenerator")

    anunciosVagaCriados AnuncioVaga[] @relation("AnuncioVagaCriador")

    cadastrosContratacaoAnalisados CadastroContratacao[] @relation("CadastroContratacaoAnalisador")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Role {
    id          String @id @default(uuid())
    name        String @unique
    description String

    employees Employee[]
    roleEpis  RoleEpi[]
    roleQuesitos RoleQuesito[]
    anunciosVaga           AnuncioVaga[]
    cadastrosContratacao CadastroContratacao[]

    deletedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Employee {
    id              String         @id @default(uuid())
    name            String
    cpf             String         @unique
    email           String         @unique
    telefone        String
    birthDate       DateTime
    status          EmployeeStatus @default(ATIVO)
    admissionDate   DateTime
    resignationDate DateTime?
    leaveReturnDate DateTime?

    nacionalidade       String?
    estadoCivil         EstadoCivil?
    racaCor             RacaCor?
    filiacao            String?
    grauInstrucao       GrauInstrucao?
    numeroCtps          String?
    serieCtps           String?
    numeroDependentes   Int?
    pis                 String?
    chavePix            String?
    cep                 String?
    logradouro          String?
    numeroEndereco      String?
    complemento         String?
    bairro              String?
    cidade              String?
    estado              String?
    valeTransporte      Boolean        @default(false)
    valeAlimentacao     Boolean        @default(false)
    planoSaude          Boolean        @default(false)

    roleId String
    role   Role   @relation(fields: [roleId], references: [id])

    companyId String
    company   Company @relation(fields: [companyId], references: [id])

    setorId String
    setor   Setor  @relation(fields: [setorId], references: [id])

    epiDeliveries EpiDelivery[]

    epiDeliveryReports EpiDeliveryReport[]

    cadastroContratacaoOrigem CadastroContratacao?

    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model EpiDeliveryReport {
    id String @id @default(uuid())

    employeeId String
    employee   Employee @relation(fields: [employeeId], references: [id])

    periodStartDate DateTime
    periodEndDate   DateTime

    pdfConteudo Bytes

    foiImpresso    Boolean @default(false)
    foiEncaminhado Boolean @default(false)
    foiAssinado    Boolean @default(false)

    generatedByUserId String?
    generatedBy       User?   @relation("EpiDeliveryReportGenerator", fields: [generatedByUserId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([employeeId])
    @@index([foiAssinado])
}

model Epi {
    id               String   @id @default(uuid())
    name             String
    caNumber         String   @unique
    caExpirationDate DateTime

    isActive Boolean @default(true)

    roleEpis   RoleEpi[]
    deliveries EpiDelivery[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model RoleEpi {
    id String @id @default(uuid())

    roleId String
    role   Role   @relation(fields: [roleId], references: [id])

    epiId String
    epi   Epi    @relation(fields: [epiId], references: [id])

    periodicityDays Int

    @@unique([roleId, epiId])
}

model Quesito {
    id        String @id @default(uuid())
    nome      String @unique
    descricao String
    bloco     String

    roleQuesitos RoleQuesito[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([bloco])
}

model RoleQuesito {
    id String @id @default(uuid())

    roleId String
    role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    quesitoId String
    quesito   Quesito @relation(fields: [quesitoId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([roleId, quesitoId])
}

model EpiDelivery {
    id String @id @default(uuid())

    employeeId String
    employee   Employee @relation(fields: [employeeId], references: [id])

    epiId String
    epi   Epi    @relation(fields: [epiId], references: [id])

    deliveredById String
    deliveredBy   User   @relation(fields: [deliveredById], references: [id])

    deliveryDate DateTime @default(now())

    nextDueDate DateTime?

    vencimentoSuspenso     DateTime?
    periodicidadePausadaEm DateTime?

    termSigned Boolean @default(false)

    createdAt DateTime @default(now())
}

model AnuncioVaga {
    id String @id @default(uuid())

    tituloVaga String

    apresentacaoEmpresa String
    sobreVaga           String
    responsabilidades   String
    requisitos          String
    beneficios          String

    localTrabalho     String
    tipoContratacao   TipoContratacaoVaga
    jornadaTrabalho   String
    faixaSalarial     String?

    roleId String
    role   Role   @relation(fields: [roleId], references: [id])

    companyId String
    company   Company @relation(fields: [companyId], references: [id])

    setorId String
    setor   Setor  @relation(fields: [setorId], references: [id])

    status StatusAnuncioVaga @default(INATIVA)

    criadoPorUserId String
    criadoPor       User   @relation("AnuncioVagaCriador", fields: [criadoPorUserId], references: [id])

    candidaturas Candidatura[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@index([createdAt])
}

model Candidatura {
    id String @id @default(uuid())

    anuncioVagaId String
    anuncioVaga   AnuncioVaga @relation(fields: [anuncioVagaId], references: [id])

    nomeCompleto String
    email        String
    telefone     String
    cpf          String?
    cidade       String
    estado       String
    linkedinUrl  String?

    pretensaoSalarial      String?
    disponibilidadeInicio  String?
    mensagemCandidato      String?

    curriculoConteudo     Bytes
    curriculoNomeArquivo  String
    curriculoTipoMime     String
    curriculoTamanhoBytes Int

    cadastroContratacao CadastroContratacao?

    createdAt DateTime @default(now())

    @@index([anuncioVagaId])
    @@index([createdAt])
    @@index([email])
}

model CadastroContratacao {
    id String @id @default(uuid())

    candidaturaId String @unique
    candidatura   Candidatura @relation(fields: [candidaturaId], references: [id])

    tokenAcesso String @unique

    roleId String
    role   Role @relation(fields: [roleId], references: [id])

    companyId String
    company   Company @relation(fields: [companyId], references: [id])

    setorId String
    setor   Setor @relation(fields: [setorId], references: [id])

    status StatusCadastroContratacao @default(AGUARDANDO_PREENCHIMENTO)

    name        String?
    cpf         String?
    email       String?
    telefone    String?
    birthDate   DateTime?
    admissionDate DateTime?

    nacionalidade     String?
    estadoCivil       EstadoCivil?
    racaCor           RacaCor?
    filiacao          String?
    grauInstrucao     GrauInstrucao?
    numeroCtps        String?
    serieCtps         String?
    numeroDependentes Int?
    pis               String?
    chavePix          String?
    cep               String?
    logradouro        String?
    numeroEndereco    String?
    complemento       String?
    bairro            String?
    cidade            String?
    estado            String?
    valeTransporte    Boolean?
    valeAlimentacao     Boolean?
    planoSaude          Boolean?

    employeeId String? @unique
    employee   Employee? @relation(fields: [employeeId], references: [id])

    analisadoPorUserId String?
    analisadoPor       User? @relation("CadastroContratacaoAnalisador", fields: [analisadoPorUserId], references: [id])
    analisadoEm        DateTime?
    enviadoEm          DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@index([tokenAcesso])
}

model EventoAuditoriaSeguranca {
    id           String   @id @default(uuid())
    tipoEvento   String
    detalhes     Json     @default("{}")
    registradoEm DateTime @default(now())

    @@index([tipoEvento])
    @@index([registradoEm])
}
